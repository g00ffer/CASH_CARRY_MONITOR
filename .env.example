# =====================================================================
# Telegram secrets
# =====================================================================
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
# Target chat id where alerts should be sent
TELEGRAM_CHAT_ID=123456789

# =====================================================================
# Telegram proxy (optional)
# =====================================================================
# Use this if Telegram API is blocked in your network.
# Supported schemes: http://, https://, socks5://
# For socks5 you need: pip install "httpx[socks]"
#
# Examples:
# TELEGRAM_PROXY=socks5://127.0.0.1:1080
# TELEGRAM_PROXY=http://user:password@127.0.0.1:8080
# TELEGRAM_PROXY=http://127.0.0.1:7890
#
# Leave empty if no proxy is needed.
TELEGRAM_PROXY=

# =====================================================================
# Binance API keys
# =====================================================================
# For public market data Stage 1 keys are usually not required.
# Keep empty unless private endpoints are needed later.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# =====================================================================
# Optional runtime overrides
# =====================================================================
# dev | dry_run | prod
MONITOR_ENVIRONMENT=dev
# Optional explicit config paths
MONITOR_SETTINGS_PATH=config/settings.yaml
MONITOR_SYMBOLS_PATH=config/symbols.yaml